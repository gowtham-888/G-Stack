#9
class Complex:
    def __init__(self,r,i):
        self.r,self.i=r,i

def add(a,b):
    return Complex(a.r+b.r,a.i+b.i)

n=int(input("How many complex numbers (N>=2)? "))

s=Complex(0,0)

for x in range(1,n+1):
    print(f"Enter C{x}:")
    r=float(input("Enter real part: "))
    i=float(input("Enter imag part: "))
    s=add(s,Complex(r,i))

print(f"Sum of {n} complex numbers = ({s.r} + {s.i}i)")




#10
class Student:
    def __init__(self):
        self.name=input("Enter Name: ")
        self.usn=input("Enter USN: ")
        self.m=[]

    def getMarks(self):
        for i in range(1,4):
            self.m.append(float(input(f"Enter Subject {i}: ")))

    def calculate(self):
        self.total=sum(self.m)
        self.per=self.total/3

        if self.per>=90:
            self.grade="A+"
        elif self.per>=80:
            self.grade="A"
        elif self.per>=70:
            self.grade="B"
        elif self.per>=60:
            self.grade="C"
        else:
            self.grade="F"

    def display(self):
        print("\nName:",self.name)
        print("USN:",self.usn)
        print("Subject 1:",self.m[0])
        print("Subject 2:",self.m[1])
        print("Subject 3:",self.m[2])
        print("Total Marks:",self.total)
        print("Percentage:",self.per)
        print("Grade:",self.grade)

s=Student()
s.getMarks()
s.calculate()
s.display()
